{
  "name": "annota",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "tauri": "tauri",
    "build:exe": "vite build && tauri build --no-bundle",
    "build:installer": "vite build && tauri build --bundles nsis",
    "check": "pnpm typecheck && pnpm test && pnpm build && cargo test --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
